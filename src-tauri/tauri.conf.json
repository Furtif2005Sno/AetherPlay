{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "AetherPlay",
    "version":  "0.1.2",
    "identifier":  "fr.jolan-nrt.aetherplay",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build \u0026\u0026 npm --prefix romm-ui run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [

                            ],
                "security":  {
                                 "csp":  null
                             },
                "withGlobalTauri":  true
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "resources":  {
                                     "../romm-ui/dist/":  "romm-ui/"
                                 }
               }
}